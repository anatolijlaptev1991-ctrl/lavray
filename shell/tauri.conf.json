{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAVRay",
  "version": "0.1.0",
  "identifier": "io.github.anatolijlaptev1991-ctrl.lavray",
  "build": {
    "frontendDist": "desktop-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LAVRay",
        "width": 960,
        "height": 640,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
